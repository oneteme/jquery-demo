[
    {
        "title": "Criteria",
        "tutorial": "advanced/criteria.md",
        "examples": [
            {
                "title":"Use Criteria as a function",
                "view": "products",
                "filter": "priceRangeByName(ef,10,30)"
            },
            {
                "title":"Criteria = ...params",
                "view": "products",
                "filter": "priceRangeByName=ef,10,30"
            }
        ]
    },
    {
        "title": "Predicate",
        "tutorial": "advanced/predicate.md",
        "examples": [
            {
                "title": "Get cheap products",
                "view": "products",
                "column": "name,unit,price",
                "filter": "price.category(cheap)"
            },
            {
                "title": "Get cheap and medium products",
                "view": "products",
                "column": "name,unit,price",
                "filter": "price.category(cheap,medium)"
            }
        ]
    }
